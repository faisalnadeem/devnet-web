@page
@model ContactModel
@{
    ViewData["Title"] = "Contact Us";
    ViewData["PageName"] = "Contact";
    ViewData["PageTitle"] = "Let's Connect and Build Something Great";
    ViewData["PageDescription"] = "Get in Touch";
    ViewData["ImagePath"] = "img/site-images/about-section.jpg";
    ViewData["ImageAlt"] = "Contact DEVNET SYSTEMS to discuss your IT project";
    ViewData["MetaTitle"] = "Contact DEVNET SYSTEMS — Get a Free Project Consultation";
    ViewData["MetaDescription"] = "Get in touch with DEVNET SYSTEMS for custom web, mobile, and software development. Call +44 7864 356775 or email info@devnetsystems.com.";
    ViewData["OgImage"] = "/img/site-images/about-section.jpg";
    ViewData["LcpImage"] = "/img/site-images/about-section.jpg";
}

@section HeadJsonLd {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.devnetsystems.com/" },
        { "@@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.devnetsystems.com/contact" }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ContactPage",
      "name": "Contact DEVNET SYSTEMS",
      "url": "https://www.devnetsystems.com/contact",
      "mainEntity": { "@@type": "Organization", "@@id": "https://www.devnetsystems.com/#organization" }
    }
    </script>
}

<partial name="Shared/_PageHeaderPartial" />
<!-- Contact Section -->
<section id="contact" class="contact section light-background" aria-labelledby="contact-title">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2 id="contact-title">Contact</h2>
        <p>We'd love to hear from you. Whether you're planning a new project, need technical support, or simply want to learn more about our services, our team is here to help.</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade" data-aos-delay="100">

        <div class="row gy-4">

            <div class="col-lg-4">
                <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="200">
                    <i class="bi bi-geo-alt flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <h3>Address</h3>
                        <p>182-184 Office 14497, High Street North, London, England, E6 2JA</p>
                    </div>
                </div><!-- End Info Item -->

                <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="300">
                    <i class="bi bi-telephone flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <h3>Call Us</h3>
                        <p><a href="tel:+447864356775" rel="noopener">+44 7864 356775</a></p>
                    </div>
                </div><!-- End Info Item -->

                <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="400">
                    <i class="bi bi-envelope flex-shrink-0" aria-hidden="true"></i>
                    <div>
                        <h3>Email Us</h3>
                        <p><a href="mailto:info@devnetsystems.com" rel="noopener">info@devnetsystems.com</a></p>
                    </div>
                </div><!-- End Info Item -->

            </div>

            <div class="col-lg-8">
                <form asp-page="Contact" method="post" class="php-email-form" data-aos="fade-up" data-aos-delay="200">
                    <div class="row gy-4">

                        <div class="col-md-6">
                            <label for="Name" class="visually-hidden">Your Name</label>
                            <input type="text" id="Name" asp-for="Name" class="form-control" placeholder="Your Name" required autocomplete="name" />
                        </div>

                        <div class="col-md-6 ">
                            <label for="Email" class="visually-hidden">Your Email</label>
                            <input type="email" id="Email" asp-for="Email" class="form-control" placeholder="Your Email" required autocomplete="email" />
                        </div>

                        <div class="col-md-12">
                            <label for="Subject" class="visually-hidden">Subject</label>
                            <input type="text" id="Subject" asp-for="Subject" class="form-control" placeholder="Subject" required />
                        </div>

                        <div class="col-md-12">
                            <label for="Message" class="visually-hidden">Message</label>
                            <textarea id="Message" class="form-control" asp-for="Message" rows="6" placeholder="Message" required></textarea>
                        </div>

                        <div class="col-md-12 text-center">
                            <div class="loading">Loading</div>
                            <div class="error-message"></div>
                            <div class="sent-message">Thank you for contacting DEVNET SYSTEMS. We will get back to you shortly.</div>

                            <button type="submit">Send Message</button>
                        </div>

                    </div>
                </form>
            </div><!-- End Contact Form -->

        </div>

    </div>

</section><!-- /Contact Section -->
