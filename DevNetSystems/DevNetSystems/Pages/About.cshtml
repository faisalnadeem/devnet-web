        { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.devnetsystems.com/" },
        { "@@type": "ListItem", "position": 2, "name": "About", "item": "https://www.devnetsystems.com/about" }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
