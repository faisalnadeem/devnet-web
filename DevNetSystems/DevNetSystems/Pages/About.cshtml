    ViewData["PageName"] = "About";
    ViewData["PageTitle"] = "Empowering Your Digital Transformation Journey";
    ViewData["PageDescription"] = "Innovative IT Solutions Provider";
    ViewData["ImagePath"] = "img/site-images/contact.jpeg";
    ViewData["ImageAlt"] = "DEVNET SYSTEMS team collaborating on IT solutions";
    ViewData["MetaTitle"] = "About DEVNET SYSTEMS — 20+ Years of IT Excellence";
    ViewData["MetaDescription"] = "DEVNET SYSTEMS is a London-based IT solutions provider empowering businesses for 20+ years with web, mobile & bespoke software development.";
    ViewData["OgImage"] = "/img/site-images/contact.jpeg";
