@using Microsoft.Extensions.Options
@using DevNetSystems.Services
@inject IOptions<SiteSettings> SiteOptions
@{
    // Centralized null-safe accessors. If appsettings.json is misconfigured in any environment,
    // these prevent NullReferenceException from bubbling up as a 500 — which is what was producing
    // the "Server error (5xx)" indexing flag in Search Console.
    var siteBaseUrl = (SiteOptions.Value?.BaseUrl ?? "https://www.devnetsystems.com").TrimEnd('/');
    var siteDisplayName = SiteOptions.Value?.Name ?? "DEVNET SYSTEMS";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- SEO Meta Tags (title, description, canonical, OG, Twitter) -->
    <partial name="_SeoMetaPartial" />

    <!-- Favicons -->
    <link href="~/img/favicon.png" rel="icon" type="image/png" />
    <link href="~/img/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="~/img/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />

    <!-- Preconnect to required origins -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin />
    <link href="https://www.googletagmanager.com" rel="preconnect" crossorigin />

    @{
        // Cut down render-blocking weight on slow mobile connections by trimming the Roboto/Poppins/Raleway
        // requests to the weights that are actually used in main.css. Saves ~30 KB on first paint.
        var fontsHref = "https://fonts.googleapis.com/css2?family=Roboto:wght@@300;400;500;700&family=Poppins:wght@@300;400;500;600;700&family=Raleway:wght@@400;500;600;700&display=swap";
    }
    <!-- Fonts (non-blocking: preload + async-attach, with no-JS fallback) -->
    <link rel="preload" as="style" href="@fontsHref" />
    <link rel="stylesheet" href="@fontsHref" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="@fontsHref" /></noscript>

    <!-- Critical above-the-fold CSS: Bootstrap is required for the layout grid + navbar.
         The remaining vendor CSS (icons, AOS, glightbox, swiper) is only used below-the-fold,
         so we async-load it with the print-media trick to keep it off the critical path. -->
    <link href="~/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />

    <link rel="preload" as="style" href="~/vendor/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/bootstrap-icons/bootstrap-icons.css" media="print" onload="this.media='all'" asp-append-version="true" />
    <link rel="preload" as="style" href="~/vendor/aos/aos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/aos/aos.css" media="print" onload="this.media='all'" asp-append-version="true" />
    <link rel="preload" as="style" href="~/vendor/glightbox/css/glightbox.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/glightbox/css/glightbox.min.css" media="print" onload="this.media='all'" asp-append-version="true" />
    <link rel="preload" as="style" href="~/vendor/swiper/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/swiper/swiper-bundle.min.css" media="print" onload="this.media='all'" asp-append-version="true" />
    <noscript>
        <link href="~/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
        <link href="~/vendor/aos/aos.css" rel="stylesheet" />
        <link href="~/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
        <link href="~/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" />
    </noscript>

    <!-- Sitewide Organization + WebSite JSON-LD (linked via @@id so per-page schemas can reference the same entity) -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "@@id": "@siteBaseUrl/#organization",
        "name": "@siteDisplayName",
        "legalName": "DEVNET SYSTEMS",
        "url": "@siteBaseUrl",
        "logo": "@siteBaseUrl/img/site-images/logo-nobg.png",
        "image": "@siteBaseUrl/img/site-images/logo-nobg.png",
        "description": "DEVNET SYSTEMS is a premier IT solutions provider with 20+ years of experience delivering web, mobile, and bespoke software development services.",
        "email": "info@@devnetsystems.com",
        "telephone": "+44 7864 356775",
        "foundingDate": "2005",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "182-184 Office 14497, High Street North",
            "addressLocality": "London",
            "addressRegion": "England",
            "postalCode": "E6 2JA",
            "addressCountry": "GB"
        },
        "sameAs": [
            "https://www.facebook.com/people/Dev-Net-Systems/61581967177051/",
            "https://www.instagram.com/devnetsystems",
            "https://www.linkedin.com/company/devnet-systems-uk"
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "@@id": "@siteBaseUrl/#website",
        "name": "@siteDisplayName",
        "url": "@siteBaseUrl",
        "inLanguage": "en-GB",
        "publisher": { "@@type": "Organization", "@@id": "@siteBaseUrl/#organization" },
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "@siteBaseUrl/?q={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>

    @await RenderSectionAsync("HeadJsonLd", required: false)
    @await RenderSectionAsync("Head", required: false)

    <!-- Google Consent Mode v2 — UK GDPR + PECR compliant.
         All advertising/analytics signals default to 'denied'. The cookie consent banner (rendered
         from _CookieConsentPartial near the bottom of <body>) calls gtag('consent','update',{...})
         when the visitor chooses Accept All or Reject All, and persists that choice in the
         devnet_cookie_consent cookie (365 days).

         For RETURNING visitors the script below reads that cookie BEFORE the gtag default call so
         GA4's first hit on the page already has the correct consent state — no flash of denied,
         no missed page_view. -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        (function () {
            var match = document.cookie.match(/(?:^|;\s*)devnet_cookie_consent=([^;]+)/);
            var stored = match ? decodeURIComponent(match[1]) : null;
            var accepted = stored === 'accepted';
            gtag('consent', 'default', {
                'ad_storage':            accepted ? 'granted' : 'denied',
                'ad_user_data':          accepted ? 'granted' : 'denied',
                'ad_personalization':    accepted ? 'granted' : 'denied',
                'analytics_storage':     accepted ? 'granted' : 'denied',
                'functionality_storage': 'granted',
                'security_storage':      'granted'
            });
        })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SYR63B085D"></script>
    <script>
        gtag('js', new Date());
        gtag('config', 'G-SYR63B085D', { 'anonymize_ip': true, 'transport_type': 'beacon' });
    </script>
</head>

<body class="@(ViewData["BodyClass"] as string ?? "index-page")">

    <a class="visually-hidden-focusable" href="#main-content">Skip to main content</a>

    <partial name="_HeaderPartial" />

    <main id="main-content" class="main">

        @RenderBody()

    </main>

    <partial name="_FooterPartial" />

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center" aria-label="Scroll to top of page"><i class="bi bi-arrow-up-short" aria-hidden="true"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Cookie consent banner (UK GDPR + PECR) — controls Consent Mode v2 state. -->
    <partial name="_CookieConsentPartial" />

    <!-- Vendor JS Files (deferred + cache-busted via asp-append-version so we can serve them with a 1-year immutable cache) -->
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js" defer asp-append-version="true"></script>
    <script src="~/vendor/php-email-form/validate.js" defer asp-append-version="true"></script>
    <script src="~/vendor/aos/aos.js" defer asp-append-version="true"></script>
    <script src="~/vendor/glightbox/js/glightbox.min.js" defer asp-append-version="true"></script>
    <script src="~/vendor/purecounter/purecounter_vanilla.js" defer asp-append-version="true"></script>
    <script src="~/vendor/imagesloaded/imagesloaded.pkgd.min.js" defer asp-append-version="true"></script>
    <script src="~/vendor/isotope-layout/isotope.pkgd.min.js" defer asp-append-version="true"></script>
    <script src="~/vendor/swiper/swiper-bundle.min.js" defer asp-append-version="true"></script>

    <!-- Main JS File -->
    <script src="~/js/main.js" defer asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
