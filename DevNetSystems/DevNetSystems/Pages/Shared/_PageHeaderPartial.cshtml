@{
    var pageTitle = ViewBag.PageTitle as string ?? ViewData["Title"] as string ?? "";
    var pageDescription = ViewBag.PageDescription as string ?? "";
    var imagePath = ViewBag.ImagePath as string ?? "img/site-images/computer-laptop.jpeg";
    var imageAlt = ViewBag.ImageAlt as string ?? pageTitle;
}

<!-- Page Header -->
<section id="page-header" class="page-header section dark-background" aria-label="@pageTitle">

    <img src="~/@imagePath" alt="@imageAlt" data-aos="fade-in" loading="eager" decoding="async" fetchpriority="high" />

    <div class="container d-flex flex-column align-items-center text-center">
        @if (!string.IsNullOrWhiteSpace(pageDescription))
        {
            <p data-aos="fade-up" data-aos-delay="100" style="font-size: 16px; color: rgba(255, 255, 255, 0.9); margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px;">@pageDescription</p>
        }
        <h1 data-aos="fade-up" data-aos-delay="200" style="margin-bottom: 15px;">@pageTitle</h1>
    </div>

</section><!-- /Page Header -->
