@page "{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = $"{Model.ErrorStatusCode} {Model.Heading}";
    ViewData["MetaTitle"] = $"{Model.ErrorStatusCode} — {Model.Heading} | DEVNET SYSTEMS";
    ViewData["MetaDescription"] = Model.SubHeading;
    ViewData["Robots"] = "noindex, follow";
    ViewData["PageName"] = "";
}

<section class="section" style="padding: 100px 0;">
    <div class="container text-center">
        <p class="text-muted" style="font-size: 14px; letter-spacing: 2px; text-transform: uppercase;">Error @Model.ErrorStatusCode</p>
        <h1 class="text-danger" style="font-size: 48px;">@Model.Heading</h1>
        <p class="text-muted" style="font-size: 18px; max-width: 640px; margin: 20px auto;">@Model.SubHeading</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted" style="font-size: 13px;">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <p class="mt-4">
            <a href="/" class="btn btn-accent">Return to Homepage</a>
            <a asp-page="/Contact" class="btn btn-outline-secondary ms-2">Contact Support</a>
        </p>

        @if (Model.ErrorStatusCode == 404)
        {
            <div class="mt-5">
                <p class="text-muted">You might be looking for:</p>
                <ul class="list-inline">
                    <li class="list-inline-item"><a asp-page="/Services">Services</a></li>
                    <li class="list-inline-item">·</li>
                    <li class="list-inline-item"><a asp-page="/Products">Products</a></li>
                    <li class="list-inline-item">·</li>
                    <li class="list-inline-item"><a asp-page="/About">About</a></li>
                    <li class="list-inline-item">·</li>
                    <li class="list-inline-item"><a asp-page="/Faq">FAQ</a></li>
                </ul>
            </div>
        }
    </div>
</section>
