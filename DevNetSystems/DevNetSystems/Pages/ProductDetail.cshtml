@page "/products/{slug}"
@model DevNetSystems.Pages.ProductDetailModel
@{
    var product = Model.Product;
    var title = product?.Title ?? "Product Details";
    var rawDesc = product?.Description ?? "";
    var shortDesc = rawDesc.Length > 158 ? rawDesc.Substring(0, 155).TrimEnd() + "..." : rawDesc;
    var imagePath = product?.ImagePath ?? "img/site-images/products.jpeg";
    var ogImage = imagePath.StartsWith("/") ? imagePath : "/" + imagePath;

    ViewData["Title"] = title;
    ViewData["PageName"] = "Products";
    ViewData["PageTitle"] = title;
    ViewData["PageDescription"] = "DEVNET SYSTEMS Product";
    ViewData["ImagePath"] = imagePath;
    ViewData["ImageAlt"] = $"{title} — a DEVNET SYSTEMS product";
    ViewData["MetaTitle"] = $"{title} — DEVNET SYSTEMS Products";
    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(shortDesc)
        ? $"Learn about {title}, a software product by DEVNET SYSTEMS."
        : shortDesc;
    ViewData["OgImage"] = ogImage;
    ViewData["OgType"] = "product";
    ViewData["LcpImage"] = ogImage;
}

@section HeadJsonLd {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.devnetsystems.com/" },
        { "@@type": "ListItem", "position": 2, "name": "Products", "item": "https://www.devnetsystems.com/products" },
        { "@@type": "ListItem", "position": 3, "name": "@title", "item": "https://www.devnetsystems.com/products/@(product?.Slug)" }
      ]
    }
    </script>
    @if (product is not null)
    {
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "@product.Title",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, iOS, Android",
          "url": "https://www.devnetsystems.com/products/@product.Slug",
          "sameAs": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.SitePath ?? "")),
          "image": "https://www.devnetsystems.com/@product.ImagePath",
          "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(product.Description)),
          "publisher": { "@@type": "Organization", "@@id": "https://www.devnetsystems.com/#organization" }
        }
        </script>
    }
}

<partial name="Shared/_PageHeaderPartial" />

@if (product is not null)
{
    <section id="product-detail" class="product-detail section" aria-labelledby="product-title">
        <div class="container" data-aos="fade-up">
            <div class="row align-items-start gy-5">
                <div class="col-lg-10 col-xl-9 mx-auto">
                    <div class="product-detail-body">
                        <h2 id="product-title" class="visually-hidden">@product.Title</h2>
                        <p class="product-detail-lead">
                            @product.Description
                        </p>

                        <div class="product-detail-sidebar mt-4">
                            <h3 class="sidebar-title">Quick Actions</h3>
                            <p class="sidebar-text">
                                Explore this product in more depth or jump directly to the live site.
                            </p>

                            @if (!string.IsNullOrEmpty(product.SitePath))
                            {
                                <a href="@product.SitePath"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="product-card-cta"
                                   aria-label="Visit @product.Title website (opens in a new tab)">
                                    Visit Site <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            }
                            <a href="/products" class="product-card-cta ms-3">
                                <i class="bi bi-arrow-left" aria-hidden="true"></i> All Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="section">
        <div class="container text-center" data-aos="fade-up">
            <h2>Product not found</h2>
            <p class="mb-4">
                We couldn't find the product you were looking for. It may have been moved or renamed.
            </p>
            <a href="/products" class="btn btn-accent">
                Back to Products
            </a>
        </div>
    </section>
}
